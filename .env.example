GIGACHAT_CREDENTIALS=ваш_ключ
# получите ключ на http://developers.sber.ru

# Настройки подключения к базе данных PostgreSQL
DATABASE_NAME=ваше_имя_базы_данных
DATABASE_PASSWORD=ваш_пароль
# Стандартные настройки
DATABASE_USER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Локальные картинки:
USE_CLOUD_STORAGE=False

# Настройка почты:
EMAIL_HOST_USER=ваша_почта
EMAIL_HOST_PASSWORD=ваш_пароль_приложения
# создаётся в настройках безопасности аккаунта
EMAIL_HOST=укажите_smtp_сервер
# Яндекс: EMAIL_HOST=smtp.yandex.ru
# Mail.ru: EMAIL_HOST=smtp.mail.ru
# Gmail: EMAIL_HOST=:smtp.gmail.com
EMAIL_PORT=465
