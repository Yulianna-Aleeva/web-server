GIGACHAT_CREDENTIALS=ваш_ключ
# получите ключ на http://developers.sber.ru

# Настройки подключения к базе данных PostgreSQL
DATABASE_NAME=ваше_имя_базы_данных
DATABASE_PASSWORD=ваш_пароль
# Стандартные настройки
DATABASE_USER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

#Картинки на Supabase Storage:
SUPABASE_S3_ACCESS_KEY_ID=ваш_Access_Key_ID
SUPABASE_S3_SECRET_ACCESS_KEY=ваш_Secret_Access_Key
SUPABASE_S3_ENDPOINT_URL=https://ваш_id_проекта.storage.supabase.co/storage/v1/s3
SUPABASE_BUCKET_NAME=products

USE_CLOUD_STORAGE=True
